+const CUSTOM_NPCS = { saved: null, draft: null };
+function renderCustomNpcs(){
+  const root = $('customNpcRoot'); if (!root || !CUSTOM_NPCS.draft) return;
+  const d = CUSTOM_NPCS.draft, dirty = !same(d, CUSTOM_NPCS.saved);
+  const flag = (id, label) => `<div class="ai-field"><label for="cn-${id}">${label}</label><select id="cn-${id}" data-cn="${id}"><option value="true"${d[id] ? ' selected' : ''}>Ativado</option><option value="false"${d[id] ? '' : ' selected'}>Desativado</option></select></div>`;
+  root.innerHTML = `<section class="tn-group" aria-label="NPCs de Prontera">
+    <h3>NPCs de Prontera</h3>
+    <p class="d">Alterações de presença dos NPCs entram em vigor após reiniciar o servidor.</p>
+    ${flag('healer', 'Curandeira')}${flag('hunter', 'Caçador')}
+    <div class="ai-field"><label for="cn-buffLevel">Nível dos buffs da curandeira<small>Bênção e Aumentar Agilidade duram 10 minutos.</small></label><select id="cn-buffLevel" data-cn="buffLevel"><option value="5"${d.buffLevel === 5 ? ' selected' : ''}>Nível 5</option><option value="10"${d.buffLevel === 10 ? ' selected' : ''}>Nível 10</option></select></div>
+    <div class="row"><span class="grow" id="cnStatus" role="status">${dirty ? 'Há alterações não salvas.' : 'Nenhuma alteração pendente.'}</span><button type="button" class="btn" id="cnSave"${dirty ? '' : ' disabled'}>Salvar configurações</button></div>
+  </section>`;
+}
+async function loadCustomNpcs(){
+  if (!$('customNpcRoot')) return;
+  try {
+    const d = await api('/api/custom-npcs');
+    if (!CUSTOM_NPCS.saved || same(CUSTOM_NPCS.saved, CUSTOM_NPCS.draft)) CUSTOM_NPCS.draft = clone(d.settings);
+    CUSTOM_NPCS.saved = clone(d.settings); renderCustomNpcs();
+  } catch (e) { $('customNpcRoot').innerHTML = `<div class="tn-note tn-warn">NPCs e nível de classe: ${esc(e.message)}</div>`; }
+}
+document.addEventListener('change', e => {
+  const el = e.target.closest && e.target.closest('[data-cn]');
+  if (!el || !$('customNpcRoot')?.contains(el) || !CUSTOM_NPCS.draft) return;
+  CUSTOM_NPCS.draft[el.dataset.cn] = el.dataset.cn === 'buffLevel' ? Number(el.value) : el.value === 'true';
+  const dirty = !same(CUSTOM_NPCS.draft, CUSTOM_NPCS.saved);
+  $('cnStatus').textContent = dirty ? 'Há alterações não salvas.' : 'Nenhuma alteração pendente.';
+  $('cnSave').disabled = !dirty;
+});
+document.addEventListener('click', async e => {
+  if (!e.target.closest('#cnSave') || !CUSTOM_NPCS.draft) return;
+  const button = e.target.closest('#cnSave'); button.disabled = true;
+  const controls = [...$('customNpcRoot').querySelectorAll('select')]; controls.forEach(el => el.disabled = true);
+  try {
+    const result = await api('/api/custom-npcs', { method: 'POST', body: JSON.stringify(CUSTOM_NPCS.draft) });
+    CUSTOM_NPCS.saved = clone(result.settings); CUSTOM_NPCS.draft = clone(result.settings);
+    renderCustomNpcs(); toast('Configurações salvas. Reinicie o servidor para aplicar.');
+  } catch (err) { controls.forEach(el => el.disabled = false); button.disabled = false; toast(err.message, true); }
+});

