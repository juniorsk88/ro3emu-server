+# ------------------------------------------------------------------ custom NPC and job controls
+CUSTOM_DEFAULT = {"healer": True, "hunter": True, "buffLevel": 10, "job50": False}
+
+def custom_npcs_path():
+    return os.path.join(TC.ROOT, "data", "custom-npcs.json")
+
+def custom_npcs_valid(raw):
+    return isinstance(raw, dict) and set(raw) == set(CUSTOM_DEFAULT) and all(
+        type(raw[k]) is bool for k in ("healer", "hunter", "job50")
+    ) and type(raw["buffLevel"]) is int and raw["buffLevel"] in (5, 10)
+
+def custom_npcs_get():
+    path = custom_npcs_path()
+    if not os.path.exists(path):
+        return 200, {"settings": CUSTOM_DEFAULT}
+    try:
+        settings = TC.read_json(path)
+    except (OSError, ValueError):
+        return 500, {"error": "Não foi possível ler as configurações dos NPCs."}
+    if not custom_npcs_valid(settings):
+        return 500, {"error": "As configurações dos NPCs estão inválidas; verifique o arquivo no servidor."}
+    return 200, {"settings": settings}
+
+def custom_npcs_set(body, ctx, who):
+    if not custom_npcs_valid(body):
+        return 400, {"error": "Informe todos os controles e escolha buffs de nível 5 ou 10."}
+    import tempfile
+    path = custom_npcs_path()
+    fd, tmp = tempfile.mkstemp(prefix=".custom-npcs-", dir=os.path.dirname(path))
+    try:
+        os.chmod(tmp, 0o644)
+        with os.fdopen(fd, "w", encoding="utf-8") as f:
+            json.dump(body, f, ensure_ascii=False, indent=2)
+            f.flush()
+            os.fsync(f.fileno())
+        os.replace(tmp, path)
+    finally:
+        if os.path.exists(tmp):
+            os.unlink(tmp)
+    log = ctx.get("log") if isinstance(ctx, dict) else None
+    if log:
+        log("CONFIG", f"Controles de NPCs e classe alterados ({who or 'token'})")
+    return 200, {"ok": True, "settings": body}
+
 # ------------------------------------------------------------------ dispatch
 def get(path, query):
+    if path == "/api/custom-npcs":
+        return custom_npcs_get()
