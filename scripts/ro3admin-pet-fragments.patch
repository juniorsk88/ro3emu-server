     return out
 
 
+_PET_ICONS = {"items": None, "loc": None, "icons": {}}
+
+
+def resolved_item_icon(row):
+    icon = row.get("_kIcon", "") or ""
+    if icon != "pet_icon_head_104.png" or row.get("_iSubType") != 906:
+        return icon
+    items, loc = table("ItemConfig"), table("Localization_en")
+    if _PET_ICONS["items"] is not items or _PET_ICONS["loc"] is not loc:
+        candidates = {}
+        for item in items.values():
+            if not isinstance(item, dict) or item.get("_iSubType") != 906:
+                continue
+            candidate = item.get("_kIcon", "") or ""
+            if candidate.startswith("pet_icon_head_") and candidate != icon:
+                name = text(item.get("_iName"))
+                if name:
+                    candidates.setdefault(name, set()).add(candidate)
+        _PET_ICONS.update(items=items, loc=loc, icons={name: next(iter(found)) for name, found in candidates.items() if len(found) == 1})
+    return _PET_ICONS["icons"].get(text(row.get("_iName")), icon)
+
